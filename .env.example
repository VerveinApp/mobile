# Copy to .env.local (gitignored) and fill in real values.
# Both of these are meant to be public/client-embeddable — Supabase's anon
# key relies on Row Level Security for real protection, not secrecy. Never
# put the service_role key here or anywhere in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# From Google Cloud Console > APIs & Services > Credentials — a "Web
# application" and an "iOS" OAuth client under the same project. Public
# identifiers, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# RevenueCat's own public SDK key (Project settings > API keys) — see
# lib/purchases.ts. A Test Store key is fine for local development; the real
# App Store key trips RevenueCat's own "Wrong API Key" guard on a
# Release-configuration build (fine for Debug/local dev either way).
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# Leave unset. Only .github/workflows/maestro.yml's own "Write .env.local"
# step sets this to '1' — it enables app/e2e-seed.tsx, a test-only backdoor
# that seeds a fake completed profile so Maestro flows can reach an
# already-onboarded state in CI. See that file's own header comment.
EXPO_PUBLIC_E2E_SEED_ENABLED=
