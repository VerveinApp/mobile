# jest-expo@57.0.5 peer-requires @react-native/jest-preset@^0.86.3, but
# react-native@0.86.2 (this project's actual pinned version) only carries
# @react-native/jest-preset@0.86.2 as its own peerOptional — a real upstream
# version mismatch between those two packages, not something fixable from
# here. Without this, a plain `npm install`/`npm ci` (no extra flags) fails
# outright with an ERESOLVE conflict — confirmed to break both a fresh local
# install and EAS Build's own "Install dependencies" phase (which has no way
# to pass --legacy-peer-deps itself). GitHub Actions' own CI already worked
# around this with an inline --legacy-peer-deps flag; this fixes it at the
# source instead, so every install path (EAS, a fresh clone, CI) picks it up
# automatically without needing to know this flag is required at all.
legacy-peer-deps=true
