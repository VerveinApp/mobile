{
  "expo": {
    "name": "VerveIn",
    "slug": "vervein",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vervein",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon-source/icon-light.png",
        "dark": "./assets/icon-source/icon-dark.png"
      },
      "bundleIdentifier": "app.vervein",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VerveIn uses Face ID to unlock the app."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "VerveIn reads your recent activity, sleep, and resting heart rate to give more honest readiness context alongside how you say you feel — nothing is written back to Health.",
          "NSHealthUpdateUsageDescription": "VerveIn never writes any data to Health — this permission is requested by a library VerveIn uses, but write access is not used.",
          "background": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.111758217482-jvl0jpan0ur9irepshacboidlvp765b9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VerveIn uses your photo library so you can add a progress photo — nothing is uploaded anywhere, it stays on this device.",
          "cameraPermission": "VerveIn uses your camera to take a progress photo — nothing is uploaded anywhere, it stays on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
