{
  "expo": {
    "name": "VerveIn",
    "slug": "vervein",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vervein",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon-source/icon-light.png",
        "dark": "./assets/icon-source/icon-dark.png"
      },
      "bundleIdentifier": "app.vervein",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VerveIn uses Face ID to unlock the app."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "VerveIn reads your recent activity, sleep, and resting heart rate to give more honest readiness context alongside how you say you feel.",
          "NSHealthUpdateUsageDescription": "VerveIn saves your completed workouts to Health so they show up alongside your other activity — nothing else is written.",
          "background": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.111758217482-jvl0jpan0ur9irepshacboidlvp765b9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VerveIn uses your photo library so you can add a progress photo — nothing is uploaded anywhere, it stays on this device.",
          "cameraPermission": "VerveIn uses your camera to take a progress photo — nothing is uploaded anywhere, it stays on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98a8a5cb-114c-4e89-b500-9162878aa113"
      }
    }
  }
}
